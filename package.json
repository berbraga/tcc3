{
  "name": "eduitsm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,blue \"npm run dev -w @eduitsm/api\" \"npm run dev -w @eduitsm/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @eduitsm/api",
    "db:migrate": "npm run db:migrate -w @eduitsm/api",
    "db:seed": "npm run db:seed -w @eduitsm/api"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "concurrently": "9.2.1",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  }
}
