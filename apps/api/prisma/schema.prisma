generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  ALUNO
  PROFESSOR
}

enum TipoAmbiente {
  INTERNO
  EXTERNO
}

enum CategoriaSwot {
  FORCA
  FRAQUEZA
  OPORTUNIDADE
  AMEACA
}

enum NivelImpacto {
  BAIXO
  MEDIO
  ALTO
}

enum StatusObjetivo {
  ATIVO
  ATINGIDO
  CANCELADO
}

enum StatusServico {
  PROPOSTO
  EM_DESENHO
  EM_OPERACAO
  DESCONTINUADO
}

enum TipoCusto {
  CAPEX
  OPEX
}

enum TipoIndicador {
  SLA
  SATISFACAO
  TEMPO_ATENDIMENTO
  CUSTO
  RECEITA
}

enum SentidoMeta {
  MAIOR_MELHOR
  MENOR_MELHOR
}

enum PerfilCenario {
  OTIMISTA
  REALISTA
  CRITICO
}

enum OrigemMedicao {
  SIMULADO
  MANUAL
}

model Usuario {
  id          String         @id @default(uuid()) @db.Uuid
  nome        String         @db.VarChar(120)
  email       String         @unique @db.VarChar(160)
  senhaHash   String         @map("senha_hash") @db.VarChar(255)
  perfil      PerfilUsuario
  criadoEm    DateTime       @default(now()) @map("criado_em")
  organizacao Organizacao?
  @@map("usuario")
}

model Organizacao {
  id String @id @default(uuid()) @db.Uuid
  usuarioId String @unique @map("usuario_id") @db.Uuid
  nome String @db.VarChar(120)
  setor String? @db.VarChar(80)
  descricao String? @db.Text
  criadaEm DateTime @default(now()) @map("criada_em")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  analises AnaliseAmbiente[]
  estrategias EstrategiaServico[]
  objetivos ObjetivoEstrategico[]
  servicos Servico[]
  cenarios CenarioSimulacao[]
  @@map("organizacao")
}

model AnaliseAmbiente {
  id String @id @default(uuid()) @db.Uuid
  organizacaoId String @map("organizacao_id") @db.Uuid
  tipo TipoAmbiente
  categoria CategoriaSwot
  descricao String @db.Text
  impacto NivelImpacto?
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  @@index([organizacaoId])
  @@map("analise_ambiente")
}

model EstrategiaServico {
  id String @id @default(uuid()) @db.Uuid
  organizacaoId String @map("organizacao_id") @db.Uuid
  perspectiva String? @db.Text
  posicao String? @db.Text
  plano String? @db.Text
  padrao String? @db.Text
  versao Int @default(1)
  atualizadaEm DateTime @default(now()) @map("atualizada_em")
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  @@unique([organizacaoId, versao])
  @@map("estrategia_servico")
}

model ObjetivoEstrategico {
  id String @id @default(uuid()) @db.Uuid
  organizacaoId String @map("organizacao_id") @db.Uuid
  codigo String @db.VarChar(20)
  descricao String @db.Text
  prazo DateTime? @db.Date
  status StatusObjetivo @default(ATIVO)
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  vinculos VinculoEstrategico[]
  indicadores Indicador[]
  @@unique([organizacaoId, codigo])
  @@index([organizacaoId])
  @@map("objetivo_estrategico")
}

model Servico {
  id String @id @default(uuid()) @db.Uuid
  organizacaoId String @map("organizacao_id") @db.Uuid
  nome String @db.VarChar(120)
  descricao String? @db.Text
  publicoAlvo String? @map("publico_alvo") @db.VarChar(120)
  status StatusServico @default(PROPOSTO)
  criadoEm DateTime @default(now()) @map("criado_em")
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  custos CustoServico[]
  demandas DemandaCapacidade[]
  vinculos VinculoEstrategico[]
  indicadores Indicador[]
  registros RegistroOperacional[]
  @@index([organizacaoId])
  @@map("servico")
}

model CustoServico {
  id String @id @default(uuid()) @db.Uuid
  servicoId String @map("servico_id") @db.Uuid
  tipo TipoCusto
  valorPrevisto Decimal @map("valor_previsto") @db.Decimal(12, 2)
  valorRealizado Decimal? @map("valor_realizado") @db.Decimal(12, 2)
  periodo String @db.VarChar(10)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  @@index([servicoId])
  @@map("custo_servico")
}

model DemandaCapacidade {
  id String @id @default(uuid()) @db.Uuid
  servicoId String @map("servico_id") @db.Uuid
  periodo String @db.VarChar(10)
  demandaPrevista Int @map("demanda_prevista")
  capacidadeInstalada Int @map("capacidade_instalada")
  unidade String @db.VarChar(30)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  @@index([servicoId])
  @@map("demanda_capacidade")
}

model VinculoEstrategico {
  id String @id @default(uuid()) @db.Uuid
  servicoId String @map("servico_id") @db.Uuid
  objetivoId String @map("objetivo_id") @db.Uuid
  justificativaValor String @map("justificativa_valor") @db.Text
  contribuicao Decimal @db.Decimal(5, 2)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  objetivo ObjetivoEstrategico @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  @@unique([servicoId, objetivoId])
  @@index([objetivoId])
  @@map("vinculo_estrategico")
}

model Indicador {
  id String @id @default(uuid()) @db.Uuid
  servicoId String @map("servico_id") @db.Uuid
  objetivoId String? @map("objetivo_id") @db.Uuid
  nome String @db.VarChar(120)
  tipo TipoIndicador
  unidade String @db.VarChar(20)
  meta Decimal @db.Decimal(12, 2)
  sentido SentidoMeta
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  objetivo ObjetivoEstrategico? @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  medicoes Medicao[]
  @@index([servicoId])
  @@index([objetivoId])
  @@map("indicador")
}

model Medicao {
  id String @id @default(uuid()) @db.Uuid
  indicadorId String @map("indicador_id") @db.Uuid
  periodoRef DateTime @map("periodo_ref") @db.Date
  valor Decimal @db.Decimal(12, 2)
  origem OrigemMedicao @default(SIMULADO)
  indicador Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  @@unique([indicadorId, periodoRef])
  @@index([indicadorId, periodoRef])
  @@map("medicao")
}

model CenarioSimulacao {
  id String @id @default(uuid()) @db.Uuid
  organizacaoId String @map("organizacao_id") @db.Uuid
  semente Int
  periodoInicio DateTime @map("periodo_inicio") @db.Date
  periodoFim DateTime @map("periodo_fim") @db.Date
  volumeRegistros Int @map("volume_registros")
  perfil PerfilCenario
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  registros RegistroOperacional[]
  @@index([organizacaoId])
  @@map("cenario_simulacao")
}

model RegistroOperacional {
  id String @id @default(uuid()) @db.Uuid
  servicoId String @map("servico_id") @db.Uuid
  cenarioId String @map("cenario_id") @db.Uuid
  dataAbertura DateTime @map("data_abertura")
  dataFechamento DateTime? @map("data_fechamento")
  tempoAtendimentoMin Int? @map("tempo_atendimento_min")
  slaCumprido Boolean @map("sla_cumprido")
  notaSatisfacao Int? @map("nota_satisfacao")
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  cenario CenarioSimulacao @relation(fields: [cenarioId], references: [id], onDelete: Cascade)
  @@index([servicoId, dataAbertura])
  @@index([cenarioId])
  @@map("registro_operacional")
}
