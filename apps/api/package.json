{
  "name": "@eduitsm/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/with-root-env.ts tsx watch src/server.ts",
    "build": "tsx scripts/with-root-env.ts prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsx scripts/with-root-env.ts prisma generate && tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "benchmark": "tsx scripts/with-root-env.ts tsx scripts/benchmark.ts",
    "db:generate": "tsx scripts/with-root-env.ts prisma generate",
    "db:migrate": "tsx scripts/with-root-env.ts prisma migrate dev",
    "db:deploy": "tsx scripts/with-root-env.ts prisma migrate deploy",
    "db:seed": "tsx scripts/with-root-env.ts prisma generate && tsx scripts/with-root-env.ts tsx prisma/seed.ts"
  },
  "dependencies": {
    "@eduitsm/shared": "0.1.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "6.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
